# Defaults to GCP staging (same as the Flutter app) so the site has catalog
# data even when the local Nest API is not running.
API_BASE_URL=https://pooja-api-staging-tcjernzh5a-el.a.run.app/api/v1
NEXT_PUBLIC_API_BASE_URL=https://pooja-api-staging-tcjernzh5a-el.a.run.app/api/v1

# Local API instead:
# API_BASE_URL=http://127.0.0.1:3000/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1

# Public site URL (Open Graph / canonical). Production: https://pavitraseva.in
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Dev only — allows POST /payments/:id/mock-confirm after checkout.
NEXT_PUBLIC_ALLOW_MOCK_PAYMENTS=true

# Web Google Sign-In — OAuth client type "Web application" from
# https://console.cloud.google.com/auth/clients?project=pooja-store-app
# Authorized JavaScript origins:
#   http://localhost:3001
#   https://pavitraseva.in
#   https://www.pavitraseva.in
#   https://pavitra-seva-web-tcjernzh5a-el.a.run.app
# Then run: GOOGLE_WEB_CLIENT_ID=....apps.googleusercontent.com ./infra/gcp/configure-google-signin.sh
GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match GOOGLE_WEB_CLIENT_ID on the API as GOOGLE_CLIENT_IDS.

# NEXT_PUBLIC_APPLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3001/login
