NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=1

# Injected by compose for container DNS — override only if needed
# DATABASE_URL=postgresql://pooja:CHANGE_ME@postgres:5432/pooja_store?schema=public
# REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-32plus-char-random-access-secret
JWT_REFRESH_SECRET=replace-with-32plus-char-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RETURN_IN_RESPONSE=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
OTP_THROTTLE_TTL_SECONDS=60
OTP_THROTTLE_LIMIT=10

CORS_ORIGINS=https://staging.poojastore.example
SWAGGER_ENABLED=false
LOG_LEVEL=info

SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

PAYMENT_MODE=live
PUBLIC_API_BASE_URL=https://api-staging.poojastore.example
PUBLIC_WEB_BASE_URL=https://staging.poojastore.example

# Order confirmation emails (set EMAIL_PROVIDER=smtp + SMTP_* to send)
# EMAIL_PROVIDER=console
# EMAIL_FROM=Pavitra Seva <noreply@pavitraseva.in>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Test keys: rzp_test_... from https://dashboard.razorpay.com
# Checkout uses Razorpay for IN as soon as KEY_ID + KEY_SECRET are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=poojastore://payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=poojastore://payments/cancel

POSTGRES_PASSWORD=change-me-strong-staging-db-password
