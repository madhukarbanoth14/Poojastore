enum PriestBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum PriestServiceMode {
  HOME_VISIT
  ONLINE
}

enum PriestApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Priest {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(120)
  userId           String?      @unique @map("user_id") @db.Uuid
  fullName         String       @map("full_name") @db.VarChar(120)
  bio              String       @db.Text
  city             String       @db.VarChar(80)
  state            String       @db.VarChar(80)
  country          String       @default("IN") @db.VarChar(2)
  languages        String[]     @default([])
  specializations  String[]     @default([])
  yearsExperience  Int          @map("years_experience")
  ratingAvg        Float        @default(4.8) @map("rating_avg")
  ratingCount      Int          @default(0) @map("rating_count")
  photoUrl         String?      @map("photo_url") @db.VarChar(512)
  market           Market       @default(IN)
  currency         CurrencyCode @default(INR)
  basePriceMinor   Int          @map("base_price_minor")
  travelFeeMinor   Int          @default(0) @map("travel_fee_minor")
  serviceFees      Json         @default("[]") @map("service_fees")
  isActive         Boolean      @default(true) @map("is_active")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  slots        PriestSlot[]
  bookings     PriestBooking[]
  samagriLists PoojariSamagriList[]

  @@index([city, isActive, sortOrder])
  @@index([market, isActive])
  @@map("priests")
}

model PriestApplication {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String?                  @map("user_id") @db.Uuid
  fullName         String                   @map("full_name") @db.VarChar(120)
  phoneE164        String                   @map("phone_e164") @db.VarChar(20)
  countryCode      String                   @map("country_code") @db.VarChar(5)
  phoneNational    String                   @map("phone_national") @db.VarChar(20)
  city             String                   @db.VarChar(80)
  state            String                   @db.VarChar(80)
  languages        String[]                 @default([])
  specializations  String[]                 @default([])
  yearsExperience  Int                      @map("years_experience")
  bio              String                   @db.Text
  basePriceMinor   Int                      @map("base_price_minor")
  travelFeeMinor   Int                      @default(0) @map("travel_fee_minor")
  serviceFees      Json                     @default("[]") @map("service_fees")
  offersHome       Boolean                  @default(true) @map("offers_home")
  offersOnline     Boolean                  @default(false) @map("offers_online")
  status           PriestApplicationStatus  @default(PENDING)
  reviewNote       String?                  @map("review_note") @db.VarChar(280)
  priestId         String?                  @unique @map("priest_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([phoneE164, status])
  @@map("priest_applications")
}

model PriestSlot {
  id        String   @id @default(uuid()) @db.Uuid
  priestId  String   @map("priest_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  priest  Priest         @relation(fields: [priestId], references: [id], onDelete: Cascade)
  booking PriestBooking?

  @@unique([priestId, startsAt])
  @@index([priestId, startsAt, isBooked])
  @@map("priest_slots")
}

model PriestBooking {
  id                     String              @id @default(uuid()) @db.Uuid
  bookingNumber          String              @unique @map("booking_number") @db.VarChar(32)
  userId                 String              @map("user_id") @db.Uuid
  priestId               String              @map("priest_id") @db.Uuid
  slotId                 String              @unique @map("slot_id") @db.Uuid
  addressId              String              @map("address_id") @db.Uuid
  serviceName            String              @map("service_name") @db.VarChar(160)
  serviceMode            PriestServiceMode   @default(HOME_VISIT) @map("service_mode")
  notes                  String?             @db.Text
  meetingProvider        String?             @map("meeting_provider") @db.VarChar(24)
  meetingId              String?             @map("meeting_id") @db.VarChar(160)
  meetingJoinUrl         String?             @map("meeting_join_url") @db.VarChar(512)
  meetingHostUrl         String?             @map("meeting_host_url") @db.VarChar(512)
  status                 PriestBookingStatus @default(PENDING_PAYMENT)
  market                 Market
  currency               CurrencyCode
  amountMinor            Int                 @map("amount_minor")
  orderId                String?             @unique @map("order_id") @db.Uuid
  cancelledAt            DateTime?           @map("cancelled_at")
  cancelReason           String?             @map("cancel_reason") @db.VarChar(280)
  cancelledByUserId      String?             @map("cancelled_by_user_id") @db.Uuid
  rescheduledFromSlotId  String?             @map("rescheduled_from_slot_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  priest         Priest          @relation(fields: [priestId], references: [id], onDelete: Restrict)
  slot           PriestSlot      @relation(fields: [slotId], references: [id], onDelete: Restrict)
  address        Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  packageBooking PackageBooking?
  samagriLists   PoojariSamagriList[]

  @@index([userId, createdAt])
  @@index([priestId, status])
  @@index([status, createdAt])
  @@map("priest_bookings")
}

model VratGuide {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique @db.VarChar(120)
  title            String   @db.VarChar(180)
  summary          String   @db.VarChar(280)
  description      String   @db.Text
  durationHint     String   @map("duration_hint") @db.VarChar(160)
  allowedFoods     String[] @default([]) @map("allowed_foods")
  avoidFoods       String[] @default([]) @map("avoid_foods")
  breakFastHow     String   @map("break_fast_how") @db.Text
  associatedPuja   String?  @map("associated_puja") @db.VarChar(160)
  relatedVidhiSlug String?  @map("related_vidhi_slug") @db.VarChar(120)
  tags             String[] @default([])
  isPublished      Boolean  @default(true) @map("is_published")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  occurrences VratOccurrence[]
  reminders   VratReminder[]

  @@index([isPublished, sortOrder])
  @@map("vrat_guides")
}

model VratOccurrence {
  id        String   @id @default(uuid()) @db.Uuid
  vratId    String   @map("vrat_id") @db.Uuid
  date      DateTime @db.Date
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  vrat VratGuide @relation(fields: [vratId], references: [id], onDelete: Cascade)

  @@unique([vratId, date])
  @@index([date])
  @@map("vrat_occurrences")
}

model VratReminder {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  vratId           String   @map("vrat_id") @db.Uuid
  remindDaysBefore Int      @default(1) @map("remind_days_before")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vrat VratGuide @relation(fields: [vratId], references: [id], onDelete: Cascade)

  @@unique([userId, vratId])
  @@index([userId])
  @@map("vrat_reminders")
}

model PrasadRecipe {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique @db.VarChar(120)
  title              String   @db.VarChar(180)
  summary            String   @db.VarChar(280)
  festivalName       String   @map("festival_name") @db.VarChar(120)
  description        String   @db.Text
  servings           Int      @default(4)
  prepMinutes        Int      @map("prep_minutes")
  ingredients        String[] @default([])
  audioUrl           String?  @map("audio_url") @db.VarChar(512)
  videoUrl           String?  @map("video_url") @db.VarChar(512)
  coverImageUrl      String?  @map("cover_image_url") @db.VarChar(512)
  relatedProductSlug String?  @map("related_product_slug") @db.VarChar(120)
  tags               String[] @default([])
  isPublished        Boolean  @default(true) @map("is_published")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  steps PrasadRecipeStep[]

  @@index([festivalName, isPublished, sortOrder])
  @@map("prasad_recipes")
}

model PrasadRecipeStep {
  id          String  @id @default(uuid()) @db.Uuid
  recipeId    String  @map("recipe_id") @db.Uuid
  stepNumber  Int     @map("step_number")
  title       String? @db.VarChar(160)
  instruction String  @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(512)
  audioUrl    String? @map("audio_url") @db.VarChar(512)

  recipe PrasadRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId])
  @@map("prasad_recipe_steps")
}

enum PackageAddonType {
  CATERING
  BAND
  TRAVEL
  PRASAD
  OTHER
}

enum PackageBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  CANCELLED
}

model PujaPackage {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique @db.VarChar(120)
  title              String       @db.VarChar(180)
  summary            String       @db.VarChar(280)
  description        String       @db.Text
  market             Market       @default(IN)
  currency           CurrencyCode @default(INR)
  allowsKit          Boolean      @default(true) @map("allows_kit")
  kitProductSlug     String?      @map("kit_product_slug") @db.VarChar(120)
  allowsPriest       Boolean      @default(true) @map("allows_priest")
  allowsPrasad       Boolean      @default(false) @map("allows_prasad")
  prasadProductSlug  String?      @map("prasad_product_slug") @db.VarChar(120)
  packageDiscountMinor Int        @default(0) @map("package_discount_minor")
  coverImageUrl      String?      @map("cover_image_url") @db.VarChar(512)
  isActive           Boolean      @default(true) @map("is_active")
  sortOrder          Int          @default(0) @map("sort_order")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  bookings PackageBooking[]

  @@index([market, isActive, sortOrder])
  @@map("puja_packages")
}

model PackageAddon {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(120)
  title       String           @db.VarChar(180)
  description String           @db.Text
  type        PackageAddonType
  market      Market           @default(IN)
  currency    CurrencyCode     @default(INR)
  priceMinor  Int              @map("price_minor")
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([market, isActive, sortOrder])
  @@map("package_addons")
}

model PackageBooking {
  id                String               @id @default(uuid()) @db.Uuid
  bookingNumber     String               @unique @map("booking_number") @db.VarChar(32)
  userId            String               @map("user_id") @db.Uuid
  packageId         String               @map("package_id") @db.Uuid
  addressId         String               @map("address_id") @db.Uuid
  includeKit        Boolean              @default(true) @map("include_kit")
  includePriest     Boolean              @default(false) @map("include_priest")
  includePrasad     Boolean              @default(false) @map("include_prasad")
  addonSlugs        String[]             @default([]) @map("addon_slugs")
  serviceName       String?              @map("service_name") @db.VarChar(160)
  notes             String?              @db.Text
  priestBookingId   String?              @unique @map("priest_booking_id") @db.Uuid
  status            PackageBookingStatus @default(PENDING_PAYMENT)
  market            Market
  currency          CurrencyCode
  subtotalMinor     Int                  @map("subtotal_minor")
  discountMinor     Int                  @default(0) @map("discount_minor")
  totalMinor        Int                  @map("total_minor")
  breakdown         Json                 @default("{}")
  orderId           String?              @unique @map("order_id") @db.Uuid
  cancelledAt       DateTime?            @map("cancelled_at")
  cancelReason      String?              @map("cancel_reason") @db.VarChar(280)
  cancelledByUserId String?              @map("cancelled_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  package       PujaPackage    @relation(fields: [packageId], references: [id], onDelete: Restrict)
  address       Address        @relation(fields: [addressId], references: [id], onDelete: Restrict)
  priestBooking PriestBooking? @relation(fields: [priestBookingId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("package_bookings")
}
