generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TEMPLE
  POOJARI
  STORE
  DELIVERY_PARTNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
}

enum Market {
  IN
  US
  CA
}

enum CurrencyCode {
  INR
  USD
  CAD
}

enum ProductType {
  PUJA_KIT
  PRASAD
  SERVICE_ADDON
  SAMAGRI
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  FULFILLING
  SHIPPED
  DELIVERED
  REFUNDED
}

enum ReturnStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MOCK
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  phoneE164         String     @unique @map("phone_e164") @db.VarChar(20)
  countryCode       String     @map("country_code") @db.VarChar(5)
  phoneNational     String     @map("phone_national") @db.VarChar(20)
  email             String?    @unique @db.VarChar(255)
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  fullName          String?    @map("full_name") @db.VarChar(120)
  googleSub         String?    @unique @map("google_sub") @db.VarChar(128)
  appleSub          String?    @unique @map("apple_sub") @db.VarChar(128)
  role              Role       @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  preferredLanguage String     @default("en") @map("preferred_language") @db.VarChar(16)
  market            Market     @default(IN)
  timezone          String?    @db.VarChar(64)
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  otpChallenges      OtpChallenge[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  birthProfile       BirthProfile?
  kidsProgress       KidsProgress[]
  priestBookings     PriestBooking[]
  priestProfile      Priest?
  priestApplications PriestApplication[]
  vratReminders      VratReminder[]
  packageBookings    PackageBooking[]
  socialIdentities   SocialIdentity[]
  savedSamagriLists           SavedSamagriList[]
  poojariSamagriListsCreated  PoojariSamagriList[] @relation("PoojariSamagriListCreatedBy")
  poojariSamagriListsReceived PoojariSamagriList[] @relation("PoojariSamagriListRecipient")
  devicePushTokens            DevicePushToken[]
  notifications               UserNotification[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

enum SocialProvider {
  GOOGLE
  APPLE
}

model SocialIdentity {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  provider       SocialProvider
  providerUserId String         @map("provider_user_id") @db.VarChar(191)
  email          String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_identities")
}

enum Rasi {
  MESHA
  VRISHABHA
  MITHUNA
  KARKA
  SIMHA
  KANYA
  TULA
  VRISHCHIKA
  DHANU
  MAKARA
  KUMBHA
  MEENA
}

model BirthProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  birthTime       String?   @map("birth_time") @db.VarChar(8)
  birthPlace      String?   @map("birth_place") @db.VarChar(160)
  birthLatitude   Float?    @map("birth_latitude")
  birthLongitude  Float?    @map("birth_longitude")
  rasi            Rasi
  nakshatra       String?   @db.VarChar(40)
  gotram          String?   @db.VarChar(80)
  cityName        String    @default("Bengaluru") @map("city_name") @db.VarChar(80)
  cityLatitude    Float     @default(12.9716) @map("city_latitude")
  cityLongitude   Float     @default(77.5946) @map("city_longitude")
  timezone        String    @default("Asia/Kolkata") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model SavedSamagriList {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(120)
  rawText   String?  @map("raw_text") @db.Text
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("saved_samagri_lists")
}

enum PoojariSamagriListStatus {
  SENT
  VIEWED
}

model PoojariSamagriList {
  id              String                   @id @default(uuid()) @db.Uuid
  priestId        String                   @map("priest_id") @db.Uuid
  createdByUserId String                   @map("created_by_user_id") @db.Uuid
  recipientUserId String                   @map("recipient_user_id") @db.Uuid
  bookingId       String                   @map("booking_id") @db.Uuid
  title           String                   @db.VarChar(120)
  rawText         String?                  @map("raw_text") @db.Text
  items           Json
  status          PoojariSamagriListStatus @default(SENT)
  sentAt          DateTime                 @default(now()) @map("sent_at")
  viewedAt        DateTime?                @map("viewed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  priest    Priest        @relation(fields: [priestId], references: [id], onDelete: Cascade)
  createdBy User          @relation("PoojariSamagriListCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  recipient User          @relation("PoojariSamagriListRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  booking   PriestBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, sentAt])
  @@index([priestId, bookingId])
  @@map("poojari_samagri_lists")
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationType {
  POOJARI_SAMAGRI_LIST
  BOOKING_CONFIRMED
  ORDER_UPDATE
  PROMO
}

model DevicePushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  platform  PushPlatform
  token     String       @db.VarChar(512)
  deviceId  String?      @map("device_id") @db.VarChar(120)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_push_tokens")
}

model UserNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(180)
  body      String           @db.Text
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notifications")
}

model PanchangDay {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @db.Date
  latitude        Float
  longitude       Float
  timezone        String   @db.VarChar(64)
  locationKey     String   @map("location_key") @db.VarChar(80)
  payload         Json
  specialNote     String?  @map("special_note") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([date, locationKey])
  @@index([date])
  @@map("panchang_days")
}

model RasiDailyGuidance {
  id              String   @id @default(uuid()) @db.Uuid
  rasi            Rasi
  date            DateTime @db.Date
  summary         String   @db.Text
  recommendedPuja String   @map("recommended_puja") @db.VarChar(160)
  activity        String   @db.VarChar(160)
  luckyColor      String   @map("lucky_color") @db.VarChar(40)
  luckyDirection  String   @map("lucky_direction") @db.VarChar(40)
  luckyNumber     Int      @map("lucky_number")
  career          String   @db.Text
  finance         String   @db.Text
  health          String   @db.Text
  travel          String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([rasi, date])
  @@index([date])
  @@map("rasi_daily_guidance")
}

model FestivalNote {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  title       String   @db.VarChar(160)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, title])
  @@index([date])
  @@map("festival_notes")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  phoneE164   String     @map("phone_e164") @db.VarChar(20)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(255)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  userAgent   String?    @map("user_agent") @db.VarChar(512)
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.VarChar(128)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(80)
  resource  String   @db.VarChar(80)
  metadata  Json     @default("{}")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique @db.VarChar(120)
  name        String       @db.VarChar(180)
  description String       @db.Text
  type        ProductType  @default(PUJA_KIT)
  market      Market
  currency    CurrencyCode
  priceMinor  Int          @map("price_minor")
  mrpMinor    Int?         @map("mrp_minor")
  imageUrl    String?      @map("image_url") @db.VarChar(512)
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  kitItems  ProductKitItem[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([type, market, isActive])
  @@map("products")
}

model ProductKitItem {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  name       String  @db.VarChar(160)
  quantity   Int     @default(1)
  isOptional Boolean @default(false) @map("is_optional")
  sortOrder  Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_kit_items")
}

model Address {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  label      String  @db.VarChar(40)
  line1      String  @db.VarChar(180)
  line2      String? @db.VarChar(180)
  city       String  @db.VarChar(80)
  state      String  @db.VarChar(80)
  postalCode String  @map("postal_code") @db.VarChar(20)
  country    String  @db.VarChar(2)
  isDefault  Boolean @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  priestBookings  PriestBooking[]
  packageBookings PackageBooking[]

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                     String @id @default(uuid()) @db.Uuid
  cartId                 String @map("cart_id") @db.Uuid
  productId              String @map("product_id") @db.Uuid
  quantity               Int    @default(1)
  unitPriceOverrideMinor Int?   @map("unit_price_override_minor")
  metadata               Json   @default("{}")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                String       @id @default(uuid()) @db.Uuid
  orderNumber       String       @unique @map("order_number") @db.VarChar(32)
  userId            String       @map("user_id") @db.Uuid
  status            OrderStatus  @default(PENDING_PAYMENT)
  market            Market
  currency          CurrencyCode
  subtotalMinor     Int          @map("subtotal_minor")
  shippingMinor     Int          @default(0) @map("shipping_minor")
  taxMinor          Int          @default(0) @map("tax_minor")
  discountMinor     Int          @default(0) @map("discount_minor")
  totalMinor        Int          @map("total_minor")
  shippingAddressId String       @map("shipping_address_id") @db.Uuid
  deliverySlot      String?      @map("delivery_slot") @db.VarChar(80)
  trackingNumber    String?      @map("tracking_number") @db.VarChar(40)
  courierName       String?      @map("courier_name") @db.VarChar(80)
  packedAt          DateTime?    @map("packed_at")
  shippedAt         DateTime?    @map("shipped_at")
  outForDeliveryAt  DateTime?    @map("out_for_delivery_at")
  deliveredAt       DateTime?    @map("delivered_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  cancelReason      String?      @map("cancel_reason") @db.VarChar(255)
  returnStatus      ReturnStatus @default(NONE) @map("return_status")
  returnReason      String?      @map("return_reason") @db.VarChar(255)
  returnRequestedAt DateTime?    @map("return_requested_at")
  paidAt            DateTime?    @map("paid_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address   @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  priestBooking   PriestBooking?
  packageBooking  PackageBooking?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  productName    String @map("product_name") @db.VarChar(180)
  quantity       Int
  unitPriceMinor Int    @map("unit_price_minor")
  totalMinor     Int    @map("total_minor")
  metadata       Json   @default("{}")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  status            PaymentStatus   @default(CREATED)
  amountMinor       Int             @map("amount_minor")
  currency          CurrencyCode
  providerOrderId   String?         @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(120)
  providerRefundId  String?         @map("provider_refund_id") @db.VarChar(120)
  refundAmountMinor Int?            @map("refund_amount_minor")
  refundedAt        DateTime?       @map("refunded_at")
  clientSecret      String?         @map("client_secret") @db.VarChar(255)
  checkoutUrl       String?         @map("checkout_url") @db.VarChar(1024)
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(180)
  eventType   String          @map("event_type") @db.VarChar(120)
  paymentId   String?         @map("payment_id") @db.Uuid
  payload     Json            @default("{}")
  processedAt DateTime        @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

enum VidhiCategory {
  FESTIVAL
  OCCASION
  DAILY
  VRAT
}

enum VidhiDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model PujaVidhi {
  id                  String          @id @default(uuid()) @db.Uuid
  slug                String          @unique @db.VarChar(120)
  title               String          @db.VarChar(180)
  summary             String          @db.VarChar(280)
  description         String          @db.Text
  category            VidhiCategory
  language            String          @default("en") @db.VarChar(16)
  bestTimeHint        String          @map("best_time_hint") @db.Text
  durationMinutes     Int             @map("duration_minutes")
  difficulty          VidhiDifficulty @default(BEGINNER)
  coverImageUrl       String?         @map("cover_image_url") @db.VarChar(512)
  audioNarrationUrl   String?         @map("audio_narration_url") @db.VarChar(512)
  videoDemoUrl        String?         @map("video_demo_url") @db.VarChar(512)
  kathaText           String?         @map("katha_text") @db.Text
  kathaAudioUrl       String?         @map("katha_audio_url") @db.VarChar(512)
  relatedProductSlug  String?         @map("related_product_slug") @db.VarChar(120)
  tags                String[]        @default([])
  isPublished         Boolean         @default(true) @map("is_published")
  sortOrder           Int             @default(0) @map("sort_order")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  steps   VidhiStep[]
  mantras VidhiMantra[]

  @@index([category, isPublished, sortOrder])
  @@map("puja_vidhis")
}

model VidhiStep {
  id               String  @id @default(uuid()) @db.Uuid
  vidhiId          String  @map("vidhi_id") @db.Uuid
  stepNumber       Int     @map("step_number")
  title            String  @db.VarChar(160)
  instruction      String  @db.Text
  transliteration  String? @db.Text
  meaning          String? @db.Text
  imageUrl         String? @map("image_url") @db.VarChar(512)
  audioUrl         String? @map("audio_url") @db.VarChar(512)
  durationSeconds  Int?    @map("duration_seconds")

  vidhi PujaVidhi @relation(fields: [vidhiId], references: [id], onDelete: Cascade)

  @@unique([vidhiId, stepNumber])
  @@index([vidhiId])
  @@map("vidhi_steps")
}

model VidhiMantra {
  id              String  @id @default(uuid()) @db.Uuid
  vidhiId         String  @map("vidhi_id") @db.Uuid
  title           String  @db.VarChar(160)
  sanskritText    String  @map("sanskrit_text") @db.Text
  transliteration String  @db.Text
  meaning         String  @db.Text
  audioUrl        String? @map("audio_url") @db.VarChar(512)
  sortOrder       Int     @default(0) @map("sort_order")

  vidhi PujaVidhi @relation(fields: [vidhiId], references: [id], onDelete: Cascade)

  @@index([vidhiId, sortOrder])
  @@map("vidhi_mantras")
}

enum KidsAgeBand {
  LITTLE
  JUNIOR
  TEEN
}

model KidsStory {
  id                String      @id @default(uuid()) @db.Uuid
  slug              String      @unique @db.VarChar(120)
  title             String      @db.VarChar(180)
  summary           String      @db.VarChar(280)
  festivalName      String      @map("festival_name") @db.VarChar(120)
  whyCelebrated     String      @map("why_celebrated") @db.Text
  importance        String      @db.Text
  ageBand           KidsAgeBand @default(JUNIOR) @map("age_band")
  language          String      @default("en") @db.VarChar(16)
  coverImageUrl     String?     @map("cover_image_url") @db.VarChar(512)
  audioUrl          String?     @map("audio_url") @db.VarChar(512)
  videoUrl          String?     @map("video_url") @db.VarChar(512)
  relatedVidhiSlug  String?     @map("related_vidhi_slug") @db.VarChar(120)
  tags              String[]    @default([])
  isPublished       Boolean     @default(true) @map("is_published")
  sortOrder         Int         @default(0) @map("sort_order")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  pages    KidsStoryPage[]
  quiz     KidsQuiz?
  progress KidsProgress[]

  @@index([ageBand, isPublished, sortOrder])
  @@map("kids_stories")
}

model KidsStoryPage {
