NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

DATABASE_URL=postgresql://pooja:pooja_dev_password@localhost:5433/pooja_store?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RETURN_IN_RESPONSE=true
SMS_PROVIDER=console

# Store ops admin (email/password). Default local email is madhukar@techfylabs.com
# SEED_ADMIN_EMAIL=madhukar@techfylabs.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_ADMIN_PHONE_E164=+919999999999
# Set ORDER_AUTO_ADVANCE=true only if you want the old simulated packing/shipping timers.

# Default packing vendor. Admin confirms a paid order, then SMS this number the slip.
# Local SMS_PROVIDER=console logs the message instead of sending.
# VENDOR_NAME=Packing vendor
# VENDOR_PHONE_E164=+919876543211

# When SMS_PROVIDER=twilio (required in production):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
OTP_THROTTLE_TTL_SECONDS=60
OTP_THROTTLE_LIMIT=10

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

SWAGGER_ENABLED=true
LOG_LEVEL=info

# Open VedAstro API (panchang angas + daily rasi phalalu). Free tier is 5 req/min; optional key for higher limits.
# VEDASTRO_API_URL=https://api.vedastro.org/api/Calculate
# VEDASTRO_API_KEY=

# Optional video meetings for online priest consults.
# Default is Jitsi (no account). Set MEETING_PROVIDER=zoom plus ZOOM_* for Zoom.
# MEETING_PROVIDER=jitsi
# JITSI_BASE_URL=https://meet.jit.si
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Optional error tracking (leave empty to disable)
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Social login (Continue with Google / Apple)
# Production always requires a verified idToken.
# Locally, the app may send a stable subject without idToken.
# SOCIAL_AUTH_REQUIRE_ID_TOKEN=true
# Comma-separated Google OAuth client IDs allowed as ID-token audience.
# Include the same Web client ID used by the website (GOOGLE_WEB_CLIENT_ID).
# GOOGLE_CLIENT_IDS=123456789-abc.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.example.pooja.service

# Payments: mock (local/dev only) | live (required in production)
PAYMENT_MODE=mock
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Production checklist (NODE_ENV=production will refuse unsafe values):
# PAYMENT_MODE=live
# SMS_PROVIDER=twilio + TWILIO_*
# OTP_RETURN_IN_RESPONSE=false
# SWAGGER_ENABLED=false
# JWT_* secrets must not contain "change-me"
# RAZORPAY_* and/or STRIPE_* + webhook secrets

# Test keys: rzp_test_... / secret from Razorpay dashboard.
# With keys set, India checkout uses Razorpay even if PAYMENT_MODE=mock.
# Webhook secret is required only when NODE_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Company UPI QR (no Razorpay). If UPI_VPA or UPI_QR_IMAGE_URL is set, India
# checkout shows your QR instead of Razorpay. Drop the PNG at
# apps/web/public/images/payments/company-upi-qr.jpeg and point UPI_QR_IMAGE_URL
# at https://pavitraseva.in/images/payments/company-upi-qr.jpeg
# UPI_VPA=yourstore@okhdfcbank
# UPI_PAYEE_NAME=Pavitra Seva
# UPI_QR_IMAGE_URL=/images/payments/company-upi-qr.jpeg

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=poojastore://payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=poojastore://payments/cancel

# Optional OCR for poojari list photo scan (Google Cloud Vision API key).
# Without this, customers can still paste list text in the app.
# GOOGLE_VISION_API_KEY=

# Push notifications: console (dev logs) | fcm (Firebase Cloud Messaging)
# PUSH_PROVIDER=console
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  # full JSON on one line

# Order confirmation email to the customer after payment succeeds.
# EMAIL_PROVIDER=console logs locally; use smtp in staging/production.
# Gmail: create an App Password for the mailbox, then set SMTP_PASS.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Pavitra Seva <pavitraseva@techfylabs.com>
PUBLIC_WEB_BASE_URL=https://pavitraseva.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pavitraseva@techfylabs.com
SMTP_PASS=
SMTP_SECURE=false
